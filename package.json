{
  "name": "greenweez-mcp",
  "version": "0.2.6",
  "description": "Unofficial Greenweez MCP server and CLI with verified cart mutations.",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "greenweez",
    "shopping-cart",
    "groceries",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ncleton-petitmaker/greenweez-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ncleton-petitmaker/greenweez-mcp/security/advisories/new"
  },
  "homepage": "https://github.com/ncleton-petitmaker/greenweez-mcp#readme",
  "main": "dist/client/greenweez.js",
  "types": "dist/client/greenweez.d.ts",
  "exports": {
    ".": {
      "types": "./dist/client/greenweez.d.ts",
      "import": "./dist/client/greenweez.js"
    },
    "./server": {
      "types": "./dist/mcp/server.d.ts",
      "import": "./dist/mcp/server.js"
    }
  },
  "type": "module",
  "bin": {
    "greenweez-mcp": "dist/mcp/server.js",
    "greenweez": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/cli.d.ts",
    "dist/client",
    "dist/mcp",
    "dist/scripts",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/**/*.test.js",
    "start": "node dist/mcp/server.js",
    "privacy:audit": "node dist/scripts/privacy-audit.js",
    "package:verify": "node scripts/verify-package.mjs",
    "release:check": "node scripts/release-check.mjs",
    "verify": "npm run check && npm test && npm run privacy:audit && npm run package:verify"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "greenweez-mcp": "github:ncleton-petitmaker/greenweez-mcp#v0.2.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.2.3",
    "typescript": "7.0.2"
  }
}
